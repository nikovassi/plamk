{
  "name": "plamk-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --ssr src/entry-server.tsx --outDir dist-ssr && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:e2e": "VITE_LEAD_ENDPOINT=https://leads.e2e.test/functions/v1/submit-lead VITE_SUPABASE_URL=https://supabase.e2e.test VITE_SUPABASE_ANON_KEY=e2e-public-anon-key SSR_OUT_DIR=dist-ssr-e2e sh -c 'vite build --ssr src/entry-server.tsx --outDir dist-ssr-e2e && vite build --outDir dist-e2e'",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4390 --strictPort",
    "icons": "node scripts/generate-icons.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
