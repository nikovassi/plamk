# Copy to .env.local for local development. Never commit real values.
# All VITE_* variables are PUBLIC (embedded in the browser bundle) — put no secrets here.

# Base path. GitHub Pages project site: /plamk/ ; custom domain: /
VITE_BASE=/plamk/
# Absolute public URL of the site (canonical links, sitemap, structured data)
VITE_SITE_URL=https://nikovassi.github.io/plamk

# Lead endpoint: Supabase Edge Function URL, e.g. https://<project>.supabase.co/functions/v1/submit-lead
VITE_LEAD_ENDPOINT=
# Supabase project (admin dashboard only). The anon key is public by design; access is enforced by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional cookieless analytics (Plausible). Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=
